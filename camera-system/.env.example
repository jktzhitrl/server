# Kopieren nach ".env" und mit den echten Zugangsdaten deiner Reolink-Kameras
# fuellen. Diese Datei (.env) NICHT committen.

# Reolink Kamera 1 (Eingang)
FRIGATE_REOLINK_EINGANG_USER=admin
FRIGATE_REOLINK_EINGANG_PASSWORD=dein_kamera_passwort

# Reolink Kamera 2 (Garten)
FRIGATE_REOLINK_GARTEN_USER=admin
FRIGATE_REOLINK_GARTEN_PASSWORD=dein_kamera_passwort
