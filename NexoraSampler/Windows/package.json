{
  "name": "nexora-sampler-windows",
  "productName": "NEXORA Sampler",
  "version": "1.0.0",
  "description": "NEXORA Sampler – Windows-Version (Electron, Web Audio, Web MIDI)",
  "main": "main.cjs",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "factory": "swift run -c release --package-path ../Packages/NexoraCore FactoryExport resources/factory",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.nexora.sampler",
    "productName": "NEXORA Sampler",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/factory",
        "to": "factory"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "NEXORA-Sampler-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NEXORA Sampler",
      "artifactName": "NEXORA-Sampler-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "NEXORA-Sampler-${version}-portable.exe"
    }
  }
}
