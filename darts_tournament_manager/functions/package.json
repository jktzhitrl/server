{
  "name": "darts-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions: serverseitig validierte Dart-Eingaben",
  "main": "lib/src/index.js",
  "engines": { "node": "20" },
  "scripts": {
